		(uuid "14e5de9c-2ac2-425b-b812-f732e28e13f4")
	)
	(text "A V+ and GND for each solar panel connection (4x for a total of 8 pins). \nThese will connect on the other side to EPS\nA data line and compute board GND for each photodiode on each solar board, \nso 4 pins per solar board (data 1, 2, 3, and GND), for a total of 16 pins, \nwhich will connect to compute board\nPass through for the camera as well, which is 8 pins between the arm-board \nand the compute board\n\n4 batt boards\nso 4 gnd, 4 pwr\n4 ntc, 4 batt- 4 batt+ and 4 battm"
		(exclude_from_sim no)
		(at 80.01 34.544 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "318010a3-975e-4416-bed1-f1adbf590063")
	)
	(text "from solar"
